# ==========================================
# 1. Database Configuration (SQLite3)
# ==========================================
SQLITE_DB_PATH=./runtime/bot.db

# (Tùy chọn) Legacy MySQL Configuration nếu sử dụng MySQL thay vì SQLite
DB_HOST=localhost
DB_PORT=3306
DB_USER=bot
DB_PASSWORD=your_secure_password_here
DB_NAME=goatbot

# Connection Pool (Chỉ dùng cho MySQL)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=60000

# ==========================================
# 2. Bot General Configuration
# ==========================================
BOT_PREFIX=!
BOT_NAME=DarkWin
BOT_LANGUAGE=vi
PORT=3000
TZ=Asia/Ho_Chi_Minh

# Admin Facebook UIDs (phân cách bằng dấu phẩy)
ADMIN_IDS=100037351338722,61578017290778

# ==========================================
# 3. AI Providers & Assistant Configuration
# ==========================================
AI_ENABLED=true
AI_AUTO_REPLY_ENABLED=true
AI_AUTO_REPLY_ONLY_GROUPS=false
AI_PROVIDER=groq # Các provider hỗ trợ: groq | gemini | openai | ollama
AI_REPLY_LIMIT=10
AI_COOLDOWN_MS=60000
AI_HISTORY_TURNS=8
AI_MAX_MEMBER_HINTS=5

# --- Groq Cloud API (Khuyên dùng cho tốc độ cao và lệnh nối từ) ---
GROQ_APIKEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI API ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (Chạy AI Offline Local) ---
AI_OLLAMA_HOST=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3:latest

# --- ComfyUI Host (Tạo ảnh AI nếu có) ---
COMFYUI_HOST=127.0.0.1:8188

# ==========================================
# 4. Cookie & AppState Auto-Refresh
# ==========================================
# Công cụ trích xuất cookie: 'adspower' | 'firefox' | 'brave' | 'chrome'
COOKIE_EXTRACTOR=adspower
CHROME_IP=127.0.0.1
CHROME_PORT=9222
CHROME_PROFILE_PATH=
FIREFOX_PROFILE=rac
RESTART_CMD=pm2 restart index

# AdsPower Browser Configuration
ADSPOWER_API=http://127.0.0.1:50325
ADSPOWER_USER_ID=
ADSPOWER_APIKEY=

# Facebook login fallback khi cần refresh appstate tự động
FB_EMAIL=your-facebook-email@example.com
FB_PASSWORD=your-facebook-password

# ==========================================
# 5. Security & Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# 6. Logging & Cache Configuration
# ==========================================
LOG_LEVEL=info
LOG_FILE_PATH=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

CACHE_ENABLED=true
CACHE_TTL_MS=120000
CACHE_MAX_SIZE=1000