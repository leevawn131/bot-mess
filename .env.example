    # Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=bot
DB_PASSWORD=your_secure_password_here
DB_NAME=goatbot

# Bot Configuration
BOT_PREFIX=!
BOT_NAME=DarkWin
BOT_LANGUAGE=vi

# Admin IDs (comma separated)
ADMIN_IDS=100037351338722,61578017290778

# Facebook login fallback for auto-refresh appstate
FB_EMAIL=your-facebook-email@example.com
FB_PASSWORD=your-facebook-password

# AI Configuration
AI_ENABLED=true
AI_AUTO_REPLY_ENABLED=true
AI_AUTO_REPLY_ONLY_GROUPS=false
AI_OLLAMA_HOST=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3:latest
AI_REPLY_LIMIT=10
AI_COOLDOWN_MS=60000
AI_HISTORY_TURNS=8
AI_MAX_MEMBER_HINTS=5

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# Cache
CACHE_ENABLED=true
CACHE_TTL_MS=120000
CACHE_MAX_SIZE=1000

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=60000