# ==========================================
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
reset_data.json
.reset-restart-trigger.js

# ==========================================
