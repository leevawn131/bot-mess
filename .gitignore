# ==========================================
/runtime/
/cache/
/modules/cache/
/logs/
/Horizon_Database/*
!/Horizon_Database/A_README.md
!/Horizon_Database/RandPass.json

# ==========================================
# 3. Database & SQLite Journal / Temp Files
# ==========================================
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal
cookies_temp.*
test_cookies.*

